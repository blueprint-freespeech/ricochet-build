# vim: filetype=yaml sw=2
filename: '[% project %]-[% c("version") %]-[% c("var/build_id") %].tar.[% c("compress_tar") %]'
version: '[% pc("rcodesign", "version") %]'
git_url: https://github.com/indygreg/apple-platform-rs.git
git_hash: 'apple-codesign/[% c("version") %]'
version: '[% c("var/versions/rcodesign") %]'
container:
  use_container: 1
  disable_network:
      build: 0

var:
  osname: 0
  arch: 0

input_files:
  - project: container-image
  - name: rust
    project: rust
    target_replace:
      '^linux-.*': linux-x86_64
      '^windows-.*': linux-x86_64
      '^macos-.*': linux-x86_64
      '^windows$': linux
      '^macos$': linux
