filename: '[% project %]-[% c("version") %]-[% c("var/build_id") %].tar.gz'
version: '[% c("var/versions/rcodesign") %]'
container:
  use_container: 0

input_files:
  - name: rcodesign-build
    project: rcodesign-build
    target_replace:
      '^linux-.*': linux-x86_64
      '^windows-.*': linux-x86_64
      '^macos-.*': linux-x86_64
      '^windows$': linux
      '^macos$': linux
